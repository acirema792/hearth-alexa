{
  "name": "hearth-alexa",
  "version": "1.0.0",
  "description": "Hearth: a care circle for Alexa+. MCP server (spec 2025-11-25, Streamable HTTP) with MCP Apps for aging parents and the family who cares for them.",
  "scripts": {
    "build:views": "node scripts/build-views.mjs",
    "start": "npm run build:views && tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:views && node --import tsx --test test/*.test.ts",
    "reset": "rm -f data/hearth.json"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/core": "^2.3.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
